# Copy to .env at the repository root. Every Python process reads that file by
# absolute path, not from the working directory. .env is git-ignored; this file
# is not.
#
# `docker compose up --build` from the repository root starts Redis, Postgres,
# and every app and migrate service you have added to compose.yaml. Compose
# loads this file, then sets REDIS__HOST=redis and POSTGRES__HOST=postgres for
# containers. Host processes keep 127.0.0.1 so they reach the published ports.
# Use 127.0.0.1, not localhost, so Windows does not stall on IPv6 while Docker
# Desktop publishes IPv4 only.
#
# Shared resources are RESOURCE__FIELD. Per-app process settings are
# APP__RESOURCE__FIELD with the app directory name uppercased
# (orders_api -> ORDERS_API). Postgres physical names are
# POSTGRES__<LOGICAL_KEY>__DATABASE. The key is the database, not the app.

# Deployment environment: local | dev | staging | prod
# "debug" logging is rejected when ENV=prod.
ENV=local

# --- Server (per app) -------------------------------------------------------
# PORT has no default: a missing line fails startup so two apps cannot both
# bind 8080. HOST defaults to 0.0.0.0 when unset.

# --- Logger (per app) -------------------------------------------------------
# Minimum severity: debug | info | warning | error | critical
# Structured uvicorn access lines. Default true. Set false to emit none.

# --- MCP (per app) ----------------------------------------------------------
# PATH defaults to /mcp. It must be an absolute path and must not be
# /livez, /readyz, or /metrics. SSE defaults to true.

# --- Redis ------------------------------------------------------------------
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__DB=0
REDIS__USE_TLS=false
# Leave unset for the unauthenticated local Redis. An empty value is an empty
# password, which is not the same thing — do not uncomment this line.
# REDIS__PASSWORD=
# Connect and command timeouts in seconds. Default 5 if unset. Values below 1
# are rejected.
# REDIS__CONNECT_TIMEOUT_SECONDS=5
# REDIS__COMMAND_TIMEOUT_SECONDS=5

# --- Postgres server --------------------------------------------------------
# Shared by every logical database. Do not set POSTGRES__DATABASE; that
# variable is rejected. Uncomment a logical-database line when
# python/packages/<key>_db is added. The value is the physical name on this
# server and may differ per environment. Two apps that pass the same key share
# that database.
POSTGRES__HOST=127.0.0.1
POSTGRES__PORT=5432
POSTGRES__USER=app
POSTGRES__PASSWORD=change-me
# SSL negotiation mode: disable | require | verify-full
# "disable" is required for the official image in Compose. Rejected when ENV=prod.
POSTGRES__SSL_MODE=disable
# Physical name of the feature_flags logical database. Other databases follow
# the same shape: POSTGRES__<KEY>__DATABASE.
POSTGRES__FEATURE_FLAGS__DATABASE=feature_flags
# POSTGRES__FRUITS__DATABASE=fruits
# POSTGRES__PEOPLE__DATABASE=people
# Connect timeout in seconds (libpq). Statement timeout in milliseconds
# (PostgreSQL statement_timeout). Pool wait in seconds (SQLAlchemy
# pool_timeout; default 30). Values below 1 are rejected. Alembic uses
# POSTGRES__CONNECT_TIMEOUT_SECONDS only; it does not inherit
# STATEMENT_TIMEOUT_MS.
# POSTGRES__CONNECT_TIMEOUT_SECONDS=5
# POSTGRES__STATEMENT_TIMEOUT_MS=5000
# POSTGRES__POOL_TIMEOUT_SECONDS=30

# --- Feature flags ----------------------------------------------------------
# Redis cache TTL for a flag after a database load or a write, in seconds.
# Default is 300 (five minutes) if unset. Values below 1 are rejected (0 would
# mean no expiry). The flag table itself lives in a database package, not here.
# FEATURE_FLAG__CACHE_TTL_SECONDS=300

# --- Prometheus -------------------------------------------------------------
# Gzip /metrics when the client sends Accept-Encoding: gzip. Default false
# (CPU vs bandwidth; the library prefers leaving this off).
# PROMETHEUS__SHOULD_GZIP=false

# --- Task runner (per app) --------------------------------------------------
# A task runner has no server port.
